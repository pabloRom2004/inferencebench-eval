+def _retokenize_outputs(results: List[Dict[str, Any]]) -> None:
+    # A harness-set flag recounts every output with the model tokenizer after timing ends,
+    # so server-reported usage and whitespace words never set the token count.
+    if os.environ.get("INFERENCE_BENCH_RETOKENIZE_OUTPUTS", "").strip() != "1":
+        return
+    tokenizer = _get_tokenizer(os.environ["INFERENCE_BENCH_BASE_MODEL"])
+    if tokenizer is None:
+        raise RuntimeError("Output retokenization is enabled but the model tokenizer could not be loaded")
+    for result in results:
+        if result.get("success"):
+            result["tokens"] = len(tokenizer.encode(result["text"], add_special_tokens=False))
+

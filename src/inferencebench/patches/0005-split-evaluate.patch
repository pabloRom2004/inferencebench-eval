+def _split_evaluate() -> bool:
+    return os.environ.get("INFERENCE_BENCH_SPLIT_EVALUATE", "").strip() == "1"
+
+
+def _same_question_reference(baseline: Dict[str, Any], sample_ids: List[Any]) -> None:
+    """Score the reference on the questions just evaluated when fewer than its full set were asked."""
+    ref = baseline.get("ref") or {}
+    log_file = ref.get("baseline_log_file")
+    if not log_file or int(ref.get("n", 0) or 0) <= len(sample_ids):
+        return
+    path = Path(log_file)
+    if not path.is_absolute():
+        path = quality_gate._repo_root() / path
+    if not path.is_file():
+        return
+    rows = {}
+    with path.open("r", encoding="utf-8") as handle:
+        for line in handle:
+            if line.strip():
+                row = json.loads(line)
+                rows[row.get("sample_id")] = row
+    picked = [rows[sample_id] for sample_id in sample_ids if sample_id in rows]
+    accuracy = _compute_accuracy(picked) if len(picked) == len(sample_ids) else None
+    if accuracy:
+        baseline["accuracy"] = accuracy
+        baseline["ref"] = {**ref, "note": f"reference accuracy on the same {len(picked)} questions"}
+
